# ShieldGate Environment Configuration

# Database Configuration
POSTGRES_DB=authdb
POSTGRES_USER=authuser
POSTGRES_PASSWORD=your_secure_password_change_me
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_redis_password_change_me
REDIS_PORT=6379

# Server Configuration
SERVER_URL=http://localhost:8080
SERVER_PORT=8080
GIN_MODE=debug

# JWT Configuration (MUST be at least 32 characters)
# Also keys the CSRF cookie HMAC, so it is required for every signing alg.
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-me

# Token signing: RS256 (default), ES256, or HS256 (legacy shared secret; no JWKS)
JWT_SIGNING_ALG=RS256
# PEM private key (RSA >= 2048 bits or EC P-256). Generate with `make jwt-keys`.
# Required when GIN_MODE=release; otherwise an ephemeral key is generated.
JWT_SIGNING_KEY_FILE=
# Extra keys accepted for verification and published in the JWKS, comma-separated.
# Rotation: add the next key here first, then swap it in as the signing key and
# move the old one here until its tokens expire.
JWT_VERIFICATION_KEY_FILES=

# Security Configuration
BCRYPT_COST=12
ACCESS_TOKEN_DURATION=3600
REFRESH_TOKEN_DURATION=2592000
ID_TOKEN_DURATION=3600
# SSO session lifetime in seconds; users re-enter credentials after this
SESSION_DURATION=86400
# Key protecting TOTP secrets and recovery codes: 32 random bytes, base64
# (openssl rand -base64 32). If unset it is derived from JWT_SECRET, and
# changing JWT_SECRET would then invalidate every enrolled authenticator.
MFA_ENCRYPTION_KEY=
AUTHORIZATION_CODE_DURATION=600

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Tenant-ID

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# RBAC: comma-separated user UUIDs with full access (tenants, permission catalog)
RBAC_SUPER_ADMIN_USER_IDS=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# SMTP Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@shieldgate.com
SMTP_FROM_NAME=ShieldGate
SMTP_USE_TLS=false

# Nginx Configuration (for production)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Monitoring Configuration (optional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_change_me

# Observability
# Prometheus metrics on their own listener (keep it off the public ingress);
# empty disables
METRICS_ADDR=:9091
# OpenTelemetry tracing is on when an OTLP endpoint is set; the standard
# OTEL_* variables apply (OTEL_SERVICE_NAME, OTEL_TRACES_SAMPLER, ...)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
